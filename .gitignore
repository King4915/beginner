:root {
  --bg: #f4f7ff;
  --panel: rgba(255, 255, 255, 0.9);
  --panel-strong: #ffffff;
  --primary: #0f172a;
  --secondary: #2563eb;
  --accent: #a78bfa;
  --muted: #64748b;
  --line: rgba(148, 163, 184, 0.25);
  --shadow: 0 18px 48px rgba(15, 23, 42, 0.08);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: 'Inter', sans-serif;
  background:
    radial-gradient(circle at top left, rgba(167, 139, 250, 0.18), transparent 20%),
    radial-gradient(circle at bottom right, rgba(37, 99, 235, 0.15), transparent 18%),
    var(--bg);
  color: var(--primary);
}

button,
a {
  font: inherit;
}

button {
  cursor: pointer;
}

.app-shell {
  max-width: 1280px;
  margin: 0 auto;
  padding: 24px 18px 64px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 20px;
  background: rgba(255, 255, 255, 0.68);
  border: 1px solid var(--line);
  border-radius: 20px;
  backdrop-filter: blur(12px);
  box-shadow: var(--shadow);
  position: sticky;
  top: 12px;
  z-index: 10;
}

.brand-block {
  display: flex;
  align-items: center;
  gap: 14px;
}

.brand-mark {
  width: 46px;
  height: 46px;
  display: grid;
  place-items: center;
  border-radius: 16px;
  background: linear-gradient(135deg, var(--secondary), var(--accent));
  color: white;
  font-weight: 800;
  letter-spacing: 0.04em;
}

.eyebrow {
  margin: 0;
  font-size: 12px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--secondary);
  font-weight: 700;
}

.brand-block h1 {
  margin: 4px 0 0;
  font-size: 1.05rem;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 20px;
}

.nav-links a {
  text-decoration: none;
  color: var(--primary);
  font-weight: 600;
  opacity: 0.8;
}

.hero {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 24px;
  padding: 34px 12px 20px;
  align-items: center;
}

.hero-copy {
  padding: 18px 8px 18px 0;
}

.tag {
  display: inline-flex;
  border-radius: 999px;
  background: rgba(37, 99, 235, 0.1);
  color: var(--secondary);
  font-size: 0.8rem;
  font-weight: 700;
  padding: 8px 12px;
}

.hero-copy h2 {
  margin: 16px 0 12px;
  font-size: clamp(2.2rem, 4vw, 4.2rem);
  line-height: 1.03;
  letter-spacing: -0.06em;
}

.hero-copy p {
  margin: 0;
  max-width: 620px;
  color: var(--muted);
  font-size: 1.05rem;
  line-height: 1.7;
}

.cta-row {
  display: flex;
  margin-top: 24px;
  gap: 12px;
  flex-wrap: wrap;
}

.primary-btn,
.secondary-btn,
.text-btn,
.filter-pill,
.sound-btn {
  border: none;
  border-radius: 12px;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.primary-btn,
.secondary-btn {
  padding: 14px 20px;
  font-weight: 700;
}

.primary-btn {
  background: linear-gradient(135deg, var(--secondary), #4f46e5);
  color: white;
  box-shadow: 0 12px 24px rgba(37, 99, 235, 0.28);
}

.secondary-btn {
  background: rgba(148, 163, 184, 0.08);
  color: var(--primary);
}

.primary-btn:hover,
.secondary-btn:hover,
.filter-pill:hover,
.sound-btn:hover,
.text-btn:hover {
  transform: translateY(-1px);
}

.stats-row {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  margin-top: 28px;
}

.stats-row div {
  display: flex;
  flex-direction: column;
  gap: 6px;
  min-width: 120px;
}

.stats-row strong {
  font-size: 1.4rem;
}

.stats-row span {
  color: var(--muted);
  font-size: 0.9rem;
}

.hero-visual {
  position: relative;
  height: 440px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.visual-card {
  background: linear-gradient(135deg, rgba(15, 23, 42, 0.96), rgba(37, 99, 235, 0.92));
  color: white;
  border-radius: 28px;
  box-shadow: var(--shadow);
}

.main-card {
  width: min(100%, 420px);
  padding: 28px 24px;
}

.mini-label {
  display: inline-block;
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  opacity: 0.82;
}

.main-card h3 {
  margin: 12px 0 18px;
  font-size: 2rem;
}

.bubble-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.bubble-row span {
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.12);
  padding: 8px 12px;
  font-weight: 600;
  font-size: 0.85rem;
}

.floating-card {
  position: absolute;
  right: 10px;
  bottom: 18px;
  width: 180px;
  background: rgba(255, 255, 255, 0.88);
  border: 1px solid var(--line);
  border-radius: 22px;
  padding: 18px 16px;
  box-shadow: var(--shadow);
}

.progress-ring {
  width: 82px;
  height: 82px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  margin: 0 auto 12px;
  background: conic-gradient(var(--secondary) 0 82%, rgba(148, 163, 184, 0.2) 82% 100%);
  position: relative;
}

.progress-ring::before {
  content: '';
  position: absolute;
  inset: 10px;
  border-radius: 50%;
  background: white;
}

.progress-ring span {
  position: relative;
  z-index: 1;
  font-weight: 800;
  color: var(--primary);
}

.floating-card p {
  margin: 0;
  text-align: center;
  color: var(--muted);
  font-weight: 600;
}

.filter-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  padding: 18px 0 8px;
  margin-top: 12px;
}

.filter-pill {
  background: rgba(148, 163, 184, 0.08);
  color: var(--primary);
  padding: 11px 14px;
  font-weight: 600;
}

.filter-pill.active {
  background: rgba(37, 99, 235, 0.12);
  color: var(--secondary);
  box-shadow: inset 0 0 0 1px rgba(37, 99, 235, 0.18);
}

.content-section {
  padding-top: 30px;
}

.section-header {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 12px;
  padding-bottom: 18px;
}

.section-header h3 {
  margin: 6px 0 0;
  font-size: clamp(1.4rem, 2vw, 2rem);
}

.text-btn {
  background: transparent;
  color: var(--secondary);
  font-weight: 700;
  padding: 0;
}

.card-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
}

.study-card {
  background: rgba(255, 255, 255, 0.8);
  border: 1px solid var(--line);
  border-radius: 24px;
  padding: 18px;
  box-shadow: var(--shadow);
}

.card-illustration {
  width: 66px;
  height: 66px;
  display: grid;
  place-items: center;
  font-size: 2.2rem;
  border-radius: 18px;
  background: linear-gradient(135deg, rgba(37, 99, 235, 0.12), rgba(167, 139, 250, 0.18));
  margin-bottom: 16px;
}

.card-header-row {
  display: flex;
  justify-content: space-between;
  align-items: start;
  gap: 18px;
}

.study-card h4 {
  margin: 0;
  font-size: 1.8rem;
  letter-spacing: -0.04em;
}

.card-header-row span {
  display: block;
  margin-top: 5px;
  color: var(--muted);
  font-size: 0.9rem;
}

.sound-btn {
  width: 38px;
  height: 38px;
  background: rgba(37, 99, 235, 0.08);
  color: var(--secondary);
  font-size: 1.05rem;
}

.meta-badge {
  display: inline-block;
  margin: 16px 0 0;
  padding: 7px 10px;
  border-radius: 999px;
  background: rgba(15, 23, 42, 0.06);
  color: var(--primary);
  font-size: 0.76rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  font-weight: 700;
}

.meaning {
  margin: 18px 0 0;
  line-height: 1.7;
  color: var(--primary);
  font-weight: 600;
}

.card-divider {
  height: 1px;
  background: var(--line);
  margin: 18px 0;
}

.example-label {
  margin: 0 0 8px;
  font-size: 0.76rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--muted);
  font-weight: 700;
}

.example {
  margin: 0;
  line-height: 1.7;
  color: var(--primary);
  font-weight: 500;
}

.note {
  margin: 14px 0 0;
  color: var(--muted);
  line-height: 1.6;
}

.phrase-card {
  background: rgba(255, 255, 255, 0.78);
}

.phrase-illustration {
  background: linear-gradient(135deg, rgba(167, 139, 250, 0.18), rgba(37, 99, 235, 0.12));
}

.practice-panel {
  margin-top: 42px;
  background: linear-gradient(135deg, rgba(15, 23, 42, 0.96), rgba(37, 99, 235, 0.92));
  border-radius: 30px;
  padding: 26px;
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  color: white;
  gap: 22px;
  box-shadow: var(--shadow);
}

.practice-copy h3 {
  margin: 10px 0 18px;
  font-size: clamp(1.8rem, 3vw, 2.5rem);
  letter-spacing: -0.05em;
}

.practice-copy ul {
  margin: 0;
  padding-left: 18px;
  line-height: 2;
  opacity: 0.92;
}

.dialogue-box {
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 22px;
  padding: 20px;
}

.dialogue-row {
  display: flex;
  align-items: end;
  gap: 12px;
  margin-bottom: 16px;
}

.right-row {
  justify-content: flex-end;
}

.avatar {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  font-weight: 800;
  background: rgba(255, 255, 255, 0.18);
}

.bubble {
  max-width: 76%;
  padding: 14px 16px;
  border-radius: 18px;
  line-height: 1.6;
}

.bubble.left {
  background: rgba(255, 255, 255, 0.12);
}

.bubble.right {
  background: rgba(167, 139, 250, 0.32);
}

.bubble p {
  margin: 0;
}

@media (max-width: 980px) {
  .hero {
    grid-template-columns: 1fr;
  }

  .card-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .practice-panel {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 640px) {
  .topbar {
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .nav-links {
    flex-wrap: wrap;
  }

  .card-grid {
    grid-template-columns: 1fr;
  }

  .section-header {
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-copy h2 {
    font-size: 2.5rem;
  }

  .main-card {
    width: 100%;
  }
}
